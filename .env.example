# ==============================================================================
# ProcureAI Local Configuration Template (Placeholders Only — No Real Secrets)
# Copy to .env and populate real values locally. NEVER commit .env.
# ==============================================================================

# --- Environment & Auth Mode ---
PROCUREAI_ENV=development
# Explicit dev-only test auth adapter (MUST be false in production)
PROCUREAI_DEV_AUTH_ENABLED=true
# Signed session secret for Next.js BFF <-> FastAPI server-to-server identity assertion
PROCUREAI_SESSION_SECRET=replace-with-at-least-32-random-chars-dev-only

# --- Web Public Origin & Internal Service DNS ---
NEXT_PUBLIC_APP_URL=http://localhost:3100
WEB_PORT=3100
API_INTERNAL_URL=http://api:8000

# --- PostgreSQL (App Runtime Role vs. Migration Owner Role) ---
POSTGRES_DB=procureai
POSTGRES_USER=procureai_owner
POSTGRES_PASSWORD=replace-with-local-db-owner-password
POSTGRES_APP_USER=procureai_app
POSTGRES_APP_PASSWORD=replace-with-local-db-app-password
POSTGRES_PORT=55432

# --- Private S3-Compatible Object Storage (RustFS / MinIO compatible) ---
OBJECTSTORE_ROOT_USER=procureai_storage
OBJECTSTORE_ROOT_PASSWORD=replace-with-local-storage-password
OBJECTSTORE_BUCKET=procureai-private-documents
OBJECTSTORE_REGION=us-east-1
OBJECTSTORE_ENDPOINT=http://objectstore:9000

# --- OpenRouter Server-Side Model Gateway (Python api/worker ONLY — NEVER web) ---
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=ProcureAI
OPENROUTER_MODEL_EXTRACTION=deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL_DECISION=typesafe/jev-router
OPENROUTER_MODEL_REASONING=typesafe/jev-router
OPENROUTER_MODEL_VISION=deepseek/deepseek-v4.1-flash
OPENROUTER_MODEL_FALLBACK=deepseek/deepseek-v4.1-flash
OPENROUTER_JEV_MAX_PROMPT_USD_PER_M=0.50
OPENROUTER_JEV_MAX_COMPLETION_USD_PER_M=1.50
# Privacy & parameter enforcement
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_REQUIRE_ZDR=true
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_MAX_RETRIES=2
OPENROUTER_TIMEOUT_SECONDS=45
# Daily pilot usage cap per tenant in USD (combined LLM + Tavily atomic reservation)
PROCUREAI_TENANT_DAILY_AI_BUDGET_USD=5.00
PROCUREAI_LLM_CACHE_TTL_SECONDS=86400

# --- Optional External Search Adapter (Tavily — Unverified Leads Only; per-tenant toggle in Settings) ---
PROCUREAI_EXTERNAL_SEARCH_ENABLED=true
TAVILY_API_KEY=tvly-replace-if-enabling-optional-external-search
PROCUREAI_TAVILY_COST_PER_CREDIT_USD=0.008000
PROCUREAI_TAVILY_CACHE_TTL_SECONDS=43200

# --- Optional Real SMTP Dispatch for RFQ Emails (leave empty to use 1-click mailto: / copy) ---
PROCUREAI_SMTP_HOST=
PROCUREAI_SMTP_PORT=587
PROCUREAI_SMTP_USER=
PROCUREAI_SMTP_PASSWORD=
PROCUREAI_SMTP_FROM_EMAIL=
PROCUREAI_SMTP_USE_TLS=true
